# === General Java build artifacts ===
*.class
*.jar
*.war
*.ear
*.log

# === Maven ===
target/
.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
release.properties
buildNumber.properties

# Keep target folders inside src directories if necessary (usually not needed)
!**/src/main/**/target/
!**/src/test/**/target/

# === Gradle (if applicable) ===
.gradle/
build/
.gradle-cache/
!gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

